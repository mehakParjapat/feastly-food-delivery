{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "prisma generate && next build"
  },
  "deploy": {
    "startCommand": "npx prisma db push && node prisma/seed.js && next start -p $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
